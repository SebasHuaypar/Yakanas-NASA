# Direccion de la API del equipo de backend (sin barra final).
# Cuando la API pase a la repo oficial, cambia solo esta linea.
NEXT_PUBLIC_API_URL=https://calendario-fuego-1022991169828.southamerica-west1.run.app

# Chatbot YakaLlama (solo servidor: NUNCA con prefijo NEXT_PUBLIC_). Clave de https://build.nvidia.com
# Pon la clave real en .env.local (no se sube al repo) o en las variables de entorno del hosting.
NVIDIA_API_KEY=
# Opcional: modelo de NVIDIA a usar (por defecto nvidia/nemotron-3.5-super-vl-120b-a12b)
NVIDIA_MODEL=
